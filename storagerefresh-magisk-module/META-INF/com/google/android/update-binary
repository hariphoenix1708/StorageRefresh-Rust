#!/sbin/sh
OUTFD=$2
ZIPFILE=$3

ui_print() {
  echo -e "ui_print $1\nui_print" >&$OUTFD
}

ui_print "- Installing StorageRefresh-Rust"
unzip -o "$ZIPFILE" -d /tmp/storagerefresh_install
cp -rf /tmp/storagerefresh_install/* $MODPATH/
rm -rf /tmp/storagerefresh_install

set_perm_recursive $MODPATH 0 0 0755 0644
set_perm $MODPATH/service.sh 0 0 0755
set_perm $MODPATH/uninstall.sh 0 0 0755
set_perm $MODPATH/system/bin/storagerefresh-rust 0 0 0755

ui_print "- Done"
